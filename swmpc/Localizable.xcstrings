    "Powers smart playlist and queue generation. Apple Intelligence uses Private Cloud Compute and requires no API token." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht intelligente Playlist- und Warteschlangengenerierung. Apple Intelligence nutzt Private Cloud Compute und benötigt keinen API-Token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsa la generación inteligente de listas de reproducción y colas. Apple Intelligence usa Private Cloud Compute y no requiere token de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet la génération intelligente de listes de lecture et de files d'attente. Apple Intelligence utilise Private Cloud Compute et ne nécessite aucun jeton d'API."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogelijk maken van slimme afspeellijst- en wachtrijgeneratie. Apple Intelligence gebruikt Private Cloud Compute en vereist geen API-token."
          }
        }
      }
    },
